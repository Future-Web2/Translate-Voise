# Get the token from @BotFather. Never commit actual secrets.
TELEGRAM_BOT_TOKEN=
# /id works before authorization. Comma-separated numeric Telegram USER IDs.
ALLOWED_USER_IDS=
# Separate keys for translation and Q&A; quotas can still be shared by account.
IO_TRANSLATION_API_KEY=
IO_QA_API_KEY=
# Verify current IDs using: python -m voicebot --models
IO_TRANSLATION_MODEL=meta-llama/Llama-3.3-70B-Instruct
IO_QA_MODEL=meta-llama/Llama-3.3-70B-Instruct
IO_BASE_URL=https://api.intelligence.io.solutions/api/v1
# Quality-first CPU model. Needs several GB RAM; see README for smaller options.
WHISPER_MODEL=large-v3
WHISPER_CPU_THREADS=2
# Railway Volume mount path /data (models are downloaded at first use).
MODEL_CACHE_DIR=/data/models
# auto supports mixed Uzbek/English/Russian; forced language is optional.
ASR_LANGUAGE=auto
# Optional short list of names/terms to help recognition; not instructions.
ASR_GLOSSARY=
ASR_TIMEOUT_SECONDS=900
MAX_DURATION_SECONDS=300
MAX_FILE_MB=20
MAX_QUEUE_SIZE=5
USER_COOLDOWN_SECONDS=5
# Local defaults; Railway supplies PORT automatically.
PORT=8080
